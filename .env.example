# Copy to .env and fill in. Never commit .env.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
PAPER=true
DRY_RUN=true

# Universe / session
SYMBOLS=SPY
SCAN_INTERVAL_SEC=60
NO_ENTRY_AFTER=15:30
FLAT_BY=15:55

# Sizing
KELLY_FRACTION=0.25
PRIOR_WIN_RATE=0.60
MAX_POS_PCT=0.02
MAX_POS_DOLLARS=5000
TARGET_DAILY_VOL=0.01
FRACTIONAL_SHARES=true

# Risk
KILL_DD_PCT=0.05
MAX_DAILY_LOSS=200
MAX_TRADES_PER_DAY=4
MAX_POSITIONS=2
STOP_COOLDOWN_MIN=30

# Governance
REVIEW_WINDOW_TRADES=30
REVIEW_MIN_TRADES=20
SUSPEND_EXPECTANCY_R=0.0
SUSPEND_PROFIT_FACTOR=1.0

# Webhook (optional; requires a secret, binds to localhost)
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8787
WEBHOOK_SECRET=
